[
{
  "id": 1,
  "margin-bottom": 4,
  "mode": "default",
  "layer": "top",
  "position": "bottom",
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "cpu",
    "memory",
    "disk",
    "disk#home",
    "battery",
  ],
  "modules-right": [
    "bluetooth",
    "network",
    "clock",
  ],
  "hyprland/workspaces": {
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
    },
    "format": "{icon}",
    "format-icons": {
      "1": "壱 󰞷 ",
      "2": "弐  ",
      "3": "参  ",
      "4": "四 󰭹 ",
      "5": "五 ⇅ ",
      "6": "六 🎮 ",
      "default": "",
    },
    "sort-by-number": true,
  },
  "clock": {
    "interval": 5,
    "format": "  {:%H:%M}",
    "tooltip-format": "{:%A %Y-%m-%d}",
  },
  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
  },
  "disk": {
    "interval": 30,
    "format": "󰋊  {percentage_used}%",
    "path": "/",
    "tooltip": true,
    "tooltip-format": "SSD (/) - {used} / {total} used ({percentage_used}%)",
  },
  "disk#home": {
    "interval": 30,
    "format": "󰉉  {percentage_used}%",
    "path": "/home",
    "tooltip": true,
    "tooltip-format": "HDD (/home) - {used} / {total} used ({percentage_used}%)",
  },
  "memory": {
    "interval": 5,
    "format": "  {}%",
    "tooltip": true,
    "tooltip-format": "Memory - {used:0.1f}GB used",
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "bluetooth": {
    "interval": 5,
    "format": "{status}",
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂯 {device_alias}",
    "format-connected-battery": "󰂯 {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "blueman-manager",
  },
  "network": {
    "interval": 1,
    "format": "󰤮",
    "format-wifi": "{icon}",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-ethernet": " ",
    "format-linked": "󰈁",
    "format-disconnected": "󰤮 ",
    "tooltip-format-wifi": "<span><b><u>{essid}</u></b></span>\t\t\t{ipaddr}\n\t {bandwidthDownBits} |  {bandwidthUpBits}",
    "tooltip-format-ethernet": "<span><b><u>{ifname}</u></b></span>\t\t\t{ipaddr}\n\t {bandwidthDownBits} |  {bandwidthUpBits}",
    "on-click": "nm-connection-editor",
  }
}
,
{
  "id": 2,
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "mode": "default",
  "layer": "top",
  "position": "top",
  "modules-left": [],
  "modules-center": [
    "custom/pod-prev",
    "custom/pod-back",
    "custom/podcast",
    "custom/pod-fwd",
    "custom/pod-next",
    "custom/pod-slower",
    "custom/pod-faster"
  ],
  "modules-right": [],
  "custom/pod-prev":   { "format": "󰒮", "on-click": "/home/kinbiko/.config/mpv/mpvctl prev",   "tooltip": false },
  "custom/pod-back":   { "format": "", "on-click": "/home/kinbiko/.config/mpv/mpvctl back",   "tooltip": false },
  "custom/podcast": {
    "exec": "/home/kinbiko/.config/mpv/mpvctl status",
    "return-type": "json",
    "interval": 2,
    "on-click": "/home/kinbiko/.config/mpv/mpvctl toggle"
  },
  "custom/pod-fwd":    { "format": "", "on-click": "/home/kinbiko/.config/mpv/mpvctl fwd",    "tooltip": false },
  "custom/pod-next":   { "format": "󰒭", "on-click": "/home/kinbiko/.config/mpv/mpvctl next",   "tooltip": false },
  "custom/pod-slower": { "format": "󰾆", "on-click": "/home/kinbiko/.config/mpv/mpvctl slower", "tooltip": false },
  "custom/pod-faster": { "format": "󰓅", "on-click": "/home/kinbiko/.config/mpv/mpvctl faster", "tooltip": false },
}
]
