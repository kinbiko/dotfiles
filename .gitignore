# This repo *is* ~/.config, which is full of state written by other programs.
# So: ignore everything, then allow only the three content dirs. `!*/` lets
# git descend into subdirectories; files still need an explicit rule.
*
!*/

!common/**
!linux/**
!macos/**

# Leading slash matters: a bare `!README.md` would un-ignore every README.md
# in every untracked app-data directory under ~/.config.
!/.gitignore
!/setup.sh
!/README.md
!/LICENSE

# Secrets and machine-local state living inside the allowed dirs.
common/gh/hosts.yml
common/espanso/match/local.yml
common/nvim/lazy-lock.json
common/dlv/.dbg_history
common/wallpapers/lockscreen
# Written by Wox at runtime; the binds that matter are in hyprland.conf.
linux/hypr/wox-binds.lua

**/.DS_Store
**/*.log
**/*.spl
**/*.add
**/__pycache__/

CLAUDE.md
nvm/
