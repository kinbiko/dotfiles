# vim: set ft=sh:
# origin/HEAD is only set by clone; repos created with `git init` + `git remote add` lack it.
local ref branch reply
ref="$(git symbolic-ref -q refs/remotes/origin/HEAD)" || {
  git remote set-head origin --auto >/dev/null || return 1
  ref="$(git symbolic-ref refs/remotes/origin/HEAD)" || return 1
}
branch="${ref#refs/remotes/origin/}"

if [ -n "$(git status --porcelain)" ]; then
  read -q "reply?Uncommitted changes. Stash them? [y/N] "
  echo
  [ "$reply" = y ] || return 1
  git stash push --include-untracked -m "default-branch: switching to $branch" || return 1
fi

git checkout "$branch" && git pull
